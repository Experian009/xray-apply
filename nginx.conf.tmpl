# Шаблон конфига nginx. ${PORT} и ${XRAY_PORT} подставляет entrypoint.sh
# (остальные $переменные nginx не трогать — envsubst вызывается со списком).
user nginx;
worker_processes 1;
error_log stderr warn;
pid /run/nginx/nginx.pid;

events {
    worker_connections 128;
}

http {
    include /etc/nginx/mime.types;
    access_log off;

    server {
        listen ${PORT};
        root /usr/share/nginx/html;
        index index.html;

        # Сайт с морским котиком. Заодно отвечает на health check платформы (200 OK).
        location / {
            try_files $uri $uri/ =404;
        }

        # VLESS + WebSocket -> Xray на localhost
        location = /vless {
            proxy_pass http://127.0.0.1:${XRAY_PORT};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 7d;
            proxy_send_timeout 7d;
        }
    }
}
